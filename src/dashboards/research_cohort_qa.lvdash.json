{
 "datasets": [
  {
   "name": "ds_kpi",
   "displayName": "KPIs",
   "queryLines": [
    "SELECT (SELECT count(*) FROM rs_af_t2d_deid) AS cohort_persons, ",
    "(SELECT count(*) FROM rs_qa_results_t2d WHERE status = 'PASS') AS pass_n, ",
    "(SELECT count(*) FROM rs_qa_results_t2d WHERE status = 'WARN') AS warn_n, ",
    "(SELECT count(*) FROM rs_qa_results_t2d WHERE status = 'FAIL') AS fail_n, ",
    "(SELECT round(avg(age_at_index), 1) FROM rs_cohort_t2d) AS mean_age_at_index"
   ]
  },
  {
   "name": "ds_attrition",
   "displayName": "Attrition",
   "queryLines": [
    "SELECT CASE step_order WHEN 0 THEN '0 All patients' WHEN 1 THEN '1 Qualifying dx' WHEN 2 THEN '2 Age 18+' ",
    "WHEN 3 THEN '3 Prior encounter' WHEN 4 THEN '4 Exclusions' WHEN 5 THEN '5 MRN list' END AS step_label, ",
    "n_persons, n_removed FROM rs_attrition_t2d WHERE step_order <= 5 ORDER BY step_order"
   ]
  },
  {
   "name": "ds_demo",
   "displayName": "Demographics",
   "queryLines": [
    "SELECT dimension, level, n_persons_display, CASE WHEN small_cell_flag THEN NULL ELSE n_persons END AS n_plot ",
    "FROM rs_qa_distribution_t2d WHERE dimension IN ('gender', 'race', 'ethnicity', 'insurance_payer') ORDER BY dimension, level"
   ]
  },
  {
   "name": "ds_age",
   "displayName": "Age bands",
   "queryLines": [
    "SELECT level AS age_band, CASE WHEN small_cell_flag THEN NULL ELSE n_persons END AS n_plot ",
    "FROM rs_qa_distribution_t2d WHERE dimension = 'age_band' ORDER BY level"
   ]
  },
  {
   "name": "ds_a1c",
   "displayName": "HbA1c distribution",
   "queryLines": [
    "SELECT 'Baseline' AS measure, format_number(floor(a1c_baseline * 4) / 4, 2) AS a1c_bin, count(*) AS n_persons ",
    "FROM rs_af_t2d_deid WHERE a1c_baseline IS NOT NULL GROUP BY 1, 2 HAVING count(*) >= 11 ",
    "UNION ALL ",
    "SELECT 'Follow-up 6-12 mo', format_number(floor(a1c_followup * 4) / 4, 2), count(*) ",
    "FROM rs_af_t2d_deid WHERE a1c_followup IS NOT NULL GROUP BY 1, 2 HAVING count(*) >= 11 ORDER BY 1, 2"
   ]
  },
  {
   "name": "ds_util",
   "displayName": "Utilization",
   "queryLines": [
    "SELECT 'ED visits' AS measure, round(avg(ed_visits_12m), 2) AS mean_per_person FROM rs_af_t2d_deid ",
    "UNION ALL SELECT 'Inpatient admissions', round(avg(inpatient_admissions_12m), 2) FROM rs_af_t2d_deid ",
    "UNION ALL SELECT 'Outpatient visits', round(avg(outpatient_visits_12m), 2) FROM rs_af_t2d_deid"
   ]
  },
  {
   "name": "ds_qa",
   "displayName": "QA checks",
   "queryLines": [
    "SELECT stage, check_id, check_name, status, detail FROM rs_qa_results_t2d ORDER BY stage, check_id"
   ]
  },
  {
   "name": "ds_small",
   "displayName": "Small cells",
   "queryLines": [
    "SELECT dimension, level, n_persons_display FROM rs_qa_distribution_t2d WHERE small_cell_flag ORDER BY dimension, level"
   ]
  }
 ],
